# ── Contact form email delivery ─────────────────────────────────────────
# The contact form (assets/contact-form.js -> /api/contact.js) sends via SMTP
# through nodemailer. Fill these in with a transactional email provider
# (e.g. Resend, Postmark, SendGrid). Do not commit real values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address inquiries are delivered to
CONTACT_TO_EMAIL=elizabethwellness00@gmail.com
# "From" address used for outgoing mail (must be a verified sender/domain with your provider)
CONTACT_FROM_EMAIL=hello@balancedbyelizabeth.com
